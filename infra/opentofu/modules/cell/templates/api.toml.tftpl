schema_version = 1
revision = "${revision}"
environment = "${environment}"
deployment_mode = "managed"
cell_id = "${cell_id}"
aws_region = "${aws_region}"
runtime_role = "api"
foundation_check_timeout = "30s"
readiness_probe_interval = "10s"

[capabilities]
architecture_probe = ${architecture_probe}
postgres = true
secrets = true
kms = true
object_storage = true
telemetry = true
redpanda = false

[telemetry]
collector_endpoint = "${collector_endpoint}"
protocol = "otlp_http"
sampling_policy = "parent_based_5pct_v1"
redaction_policy_version = "allowlist_v1"

[client_telemetry]
release_id = "${web_release_id}"
web_asset_digest = "${web_asset_digest}"
configuration_schema_version = 1
configuration_revision = "${web_config_revision}"
configuration_fingerprint = "${web_config_fingerprint}"
proof_key_active_ref = "proof-key-active"
proof_key_standby_ref = "proof-key-standby"
%{ if previous_web_identity != null ~}

[client_telemetry.previous]
release_id = "${previous_web_identity.release_id}"
web_asset_digest = "${previous_web_identity.web_asset_digest}"
configuration_schema_version = ${previous_web_identity.configuration_schema_version}
configuration_revision = "${previous_web_identity.configuration_revision}"
configuration_fingerprint = "${previous_web_identity.configuration_fingerprint}"
%{ endif ~}

[server]
listen_address = "0.0.0.0:8080"
allowed_origins = ["https://${cloudfront_domain}"]
trusted_proxy_cidrs = [${trusted_proxy_cidrs}]
unary_rpc_timeout = "10s"
stream_rpc_timeout = "25s"

[secrets]
provider = "aws_parameter_store"
aws_region = "${aws_region}"
parameter_path = "${parameter_path}"

[postgres]
host = "${database_host}"
port = 5432
name = "accountable"
user = "accountable_api"
role = "accountable_api"
password_ref = "database-password"
tls_mode = "verify-full"
tls_root_ca_file = "/etc/ssl/certs/aws-rds-global-bundle.pem"
connect_timeout = "5s"
statement_timeout = "10s"
health_check_interval = "10s"
max_connections = 16
timezone = "UTC"

[object_storage]
provider = "s3"
region = "${aws_region}"
bucket = "${data_bucket}"
prefix = "foundation"
expected_owner = "${account_id}"
kms_key_arn = "${kms_key_arn}"
access_purpose = "foundation-proof"

[kms]
provider = "aws_kms"
region = "${aws_region}"
kms_key_arn = "${kms_key_arn}"
encryption_context_prefix = "accountable.${cell_id}"

[time]
provider = "linux"
max_clock_error = "1s"
max_database_skew = "1s"
