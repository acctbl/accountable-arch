schema_version = 1
revision = "${revision}"
environment = "${environment}"
deployment_mode = "managed"
cell_id = "${cell_id}"
aws_region = "${aws_region}"
runtime_role = "migrate"
foundation_check_timeout = "30s"
readiness_probe_interval = "10s"

[capabilities]
architecture_probe = false
postgres = true
secrets = true
kms = false
object_storage = false
telemetry = true
redpanda = false

[telemetry]
collector_endpoint = "${collector_endpoint}"
protocol = "otlp_http"
sampling_policy = "parent_based_5pct_v1"
redaction_policy_version = "allowlist_v1"

[secrets]
provider = "aws_parameter_store"
aws_region = "${aws_region}"
parameter_path = "${parameter_path}"

[postgres]
host = "${database_host}"
port = 5432
name = "accountable"
user = "accountable_migrate"
role = "accountable_migrate"
password_ref = "database-password"
tls_mode = "verify-full"
tls_root_ca_file = "/etc/ssl/certs/aws-rds-global-bundle.pem"
connect_timeout = "5s"
statement_timeout = "30s"
health_check_interval = "10s"
max_connections = 2
timezone = "UTC"

[time]
provider = "linux"
max_clock_error = "1s"
max_database_skew = "1s"
